void setup() {
  Serial.begin(115200);
#if defined(ESP32)
  Wire.setPins(8, 9);
#endif
  Wire.begin(8, 9);
  delay(100);
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDR)) {
    Serial.println(F("SSD1306 allocation failed"));
    for (;;);
  }
  display.setRotation(0);
  display.clearDisplay();
  display.display();
}

void loop() {
  display.clearDisplay();
  display.drawBitmap(0, 0, frame0, 128, 64, SSD1306_WHITE);
  display.display();
}
